class NCollection_LocalArray(Generic[_T]):
    """NCollection_LocalArray<T, MAX_ARRAY_SIZE = 1024>: a buffer that holds up to MAX_ARRAY_SIZE elements in the object
    itself and moves to the heap beyond. Instantiations are the concrete classes NCollection_LocalArray__<T>;
    NCollection_LocalArray[T] returns them. ToArray1() is a view: while it lives, a growing Reallocate or Allocate raises
    BufferError (R-VIEW-GUARD)."""
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, theSize: int) -> None: ...
    def Allocate(self, theSize: int) -> None: ...
    def Reallocate(self, theNewSize: int, theToCopy: bool = True) -> None: ...
    def Size(self) -> int: ...
    def ToArray1(self) -> NCollection_Array1[_T]: ...
