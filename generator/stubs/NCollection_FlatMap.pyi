class NCollection_FlatMap(Generic[_K, _H]):
    """NCollection_FlatMap<Key>: hashed set of keys with open addressing (OCCT). Every insertion or removal can move the
    other keys, so while ChangeSeek's key lives they raise BufferError (R-VIEW-GUARD)."""
    class Iterator(Generic[_IK, _IH]):
        @overload
        def __init__(self) -> None: ...
        @overload
        def __init__(self, theMap: NCollection_FlatMap[_IK, _IH]) -> None: ...
        def More(self) -> bool: ...
        def Next(self) -> None: ...
        def Value(self) -> _IK: ...
        def __iter__(self) -> collections.abc.Iterator[_IK]: ...   # a separate iterator (R-ITER), not the object
        def Key(self) -> _IK: ...
        def IsEqual(self, theOther: NCollection_FlatMap.Iterator[_IK, _IH]) -> bool: ...
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, theNbBuckets: int) -> None: ...
    @overload
    def __init__(self, theOther: NCollection_FlatMap[_K, _H]) -> None: ...
    def Size(self) -> int: ...
    def IsEmpty(self) -> bool: ...
    def Capacity(self) -> int: ...
    def Clear(self, doReleaseMemory: bool = False) -> None: ...
    def Exchange(self, theOther: NCollection_FlatMap[_K, _H]) -> None: ...
    def Reserve(self, theN: int) -> None: ...
    def reserve(self, theN: int) -> None: ...
    def Add(self, theKey: _K) -> bool: ...
    def Added(self, theKey: _K) -> _K: ...
    def Contains(self, theKey: _K) -> bool: ...
    def Contained(self, theKey: _K) -> _K | None: ...
    def Remove(self, theKey: _K) -> bool: ...
    def Seek(self, theKey: _K) -> _K | None: ...
    def ChangeSeek(self, theKey: _K) -> _K | None: ...
    def __contains__(self, theKey: _K) -> bool: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> collections.abc.Iterator[_K]: ...
