.venv/
build/
__pycache__/
*.pyc
.pytest_cache/
# local OCCT/FreeType/RapidJSON sources and builds: only the deps/*.sh scripts are tracked, and they
# fetch and build everything from a pinned version, so the downloads themselves stay out of the repository
deps/occt-src/
deps/occt-build/
deps/occt-8.0.1/
deps/occt-build.log
deps/freetype-src/
deps/freetype-build/
deps/freetype/
deps/freetype-2.14.3.tar.xz
deps/rapidjson-src/
deps/rapidjson/
deps/rapidjson-1.1.0.tar.gz
deps/rapidjson-1.1.0-718.patch
.mypy_cache/
.ruff_cache/

# review reports (local, not published)
reviews/
# Generated by the generator, and deliberately not tracked (decision 2026-09-23, Design.md 5.3): the bindings are
# ephemeral build input that every platform must produce for itself. OCCT's headers are platform-dependent --
# WNT_Window.hxx is behind `#if defined(_WIN32)`, so a macOS generation produces no WNT_Window at all -- one
# generation platform cannot serve the others, and the .so/.pyd files are the product, not the C++ or the reports.
# Four files under src/ are hand-written and stay tracked: src/cpp/common/nanoocp_common.h,
# src/cpp/common/nanoocp_ncollection.h, src/nanoocp/_templates.py and src/nanoocp/py.typed.
# Everything below is rebuilt in minutes by `python -m generator`.
/src/cpp/**/*.cpp
/src/cpp/**/report.txt
/src/cpp/manifest.json
/src/cpp/toolkits.cmake
/src/cpp/common/ncollection_docs.h
/src/nanoocp/**/*.py
/src/nanoocp/**/*.pyi
!/src/nanoocp/_templates.py

# staged trees the Makefile builds for stubs/test (deps/stage.sh)
stage-mac/
stage-ml/
stage-win/

# built and repaired wheels (make wheel); the repaired one carries the bundled OCCT libraries, ~44 MB
dist/
